# C=CEDULA, E=CEDULA EXTRANJERIA, P=PASAPORTE, A=NIT...
SURA_DOC_TYPE=C
SURA_USER=mi_usuario_real
SURA_PASS=mi_password_segura
CEDULA_CONSULTA=numero_cedula_a_consultar
CIUDAD=Medellin
CIUDAD_CIRCULACION=Medellin
# Carro o Moto
TIPO_VEHICULO=Carro
PLACA=ABC123
HEADLESS=false
# Pausa (ms) entre pasos del cotizador para que Sura recalcule la tarifa
PAUSA_COTIZADOR_MS=2500
# API REST (npm run server)
PORT=3000
HOST=127.0.0.1
API_KEY=cambia_esta_clave
# Webhook de Make que recibe el resultado de cada cotización
MAKE_WEBHOOK_URL=https://hook.us1.make.com/xxxxxxxxxxxxxxxx
